  "bugs": {
    "url": "https://github.com/LalitNarayan824/Uppy/issues"
  },
  "homepage": "https://github.com/LalitNarayan824/Uppy#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bullmq": "^6.1.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^6.9.15",
    "postgres": "^3.4.9",
    "uuid": "^14.0.1"
  },
