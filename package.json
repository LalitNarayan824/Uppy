    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^6.4.16",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
